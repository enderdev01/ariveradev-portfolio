# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=

# Host port for the Umami dashboard (3000 is taken by `next dev`).
UMAMI_PORT=3001

# Ad-blocker evasion: these rename the default tracker paths.
# The script is served at /<TRACKER_SCRIPT_NAME>.js
TRACKER_SCRIPT_NAME=metrics.js
COLLECT_API_ENDPOINT=/api/send
